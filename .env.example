# --- NEDS chat PoC configuration ---
# Copy to .env and fill in. Never commit .env.

# HTTP server
PORT=8787

# Local LLM (LM Studio on the Mac Studio, OpenAI-compatible server).
# Point this at the Studio's Tailscale address once LM Studio's server is running.
# Example: http://100.x.y.z:1234/v1   (Tailscale IP)  or  http://mac-studio.tailXXXX.ts.net:1234/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-4b
LLM_API_KEY=lm-studio
# Hard ceiling on model time before we fall back to a phone/email hand-off (ms)
LLM_TIMEOUT_MS=8000

# Guardrails for the public answer path
MAX_MESSAGE_CHARS=600
MAX_ANSWER_WORDS=120

# Set to "mock" to run the whole pipeline without a live model (returns a
# templated grounded answer). Set to "live" to call LLM_BASE_URL.
LLM_MODE=live
